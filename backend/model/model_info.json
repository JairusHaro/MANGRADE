    "phase1": "base frozen, lr 1e-3, up to 20 epochs",
    "phase2": "last 30 layers, lr 1e-5, 15 epochs",
    "phase3": "last 80 layers, lr 1e-4 halved on plateau, early stopping patience 8",
    "best_epoch": 35,
    "epochs_run": 43,
    "class_weight": {
      "Extra_Class": 1.337,
      "Class_I": 0.554,
      "Class_II": 1.165,
